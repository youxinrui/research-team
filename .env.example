# OpenAI 兼容接口配置
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://your-provider.example.com/v1
MODEL_NAME=your-model-name

# 可选配置
OUTPUT_DIR=output
SEARCH_PROVIDER=so360
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_PATH=output/checkpoints.sqlite
CHAT_DB_PATH=output/chat.db

# 知识库 embedding
# provider: openai = 任意 OpenAI 兼容 /embeddings 服务；hash = 本地哈希向量（无需 key，语义弱）
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_INDEX_DIR=knowledge/.index
KB_TOP_K=3
KB_VEC_MIN=0.55
KB_BM25_MIN=5.0
KB_VECTOR_WEIGHT=0.1
MAX_STEPS=20
MAX_REVISIONS=2
